rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Being signed in is not enough: an account becomes a student only after the
    // email link is verified. This is the server-side half of the verification
    // gate the session UI enforces.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function myUid() {
      return request.auth.uid;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myCollegeId() {
      return myProfile().collegeId;
    }

    function isSameCollege(collegeId) {
      return isSignedIn() && myCollegeId() == collegeId;
    }

    function isBoardModerator(boardId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/boards/$(boardId)).data.moderatorIds;
    }

    // A vote update may only add or remove the caller's own UID. The score is
    // always derived from the two lists, so it cannot drift away from them:
    // +1 for a new upvote, -1 for removing it, and -2/+2 when switching sides.
    function validVote(before, after) {
      return after.score is int
        && after.upvotedBy is list
        && after.downvotedBy is list
        && after.score == after.upvotedBy.size() - after.downvotedBy.size()
        && before.upvotedBy.removeAll([request.auth.uid]) == after.upvotedBy.removeAll([request.auth.uid])
        && before.downvotedBy.removeAll([request.auth.uid]) == after.downvotedBy.removeAll([request.auth.uid])
        && !(request.auth.uid in after.upvotedBy && request.auth.uid in after.downvotedBy);
    }

    // The email domain is the only server-checkable link between an account and a
    // college. Checking it on profile creation stops a verified account from
    // claiming a college whose students it is not part of.
    function myEmailDomain() {
      return request.auth.token.email.split('@')[1].lower();
    }

    function collegeAcceptsMyEmail(collegeId) {
      return get(/databases/$(database)/documents/colleges/$(collegeId)).data.emailDomains.hasAny([myEmailDomain()]);
    }

    // The sign-up screen needs the college list before a Firebase account exists,
    // so colleges are readable by everyone. Nobody can write them from the app.
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      // Owners can read their own profile. Other students can read it only when
      // their own profile says they belong to the same college.
      allow read: if isOwner(uid) || isSameCollege(resource.data.collegeId);

      // A new profile must start as a student with no badges and zero karma.
      allow create: if isOwner(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.karma == 0
        && request.resource.data.badges == []
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 500
        && (request.resource.data.avatarUrl == ''
          || request.resource.data.avatarUrl.matches('^https://.+$'))
        && request.resource.data.collegeId is string
        && request.resource.data.collegeId.size() > 0
        && collegeAcceptsMyEmail(request.resource.data.collegeId);

      // Edits can only touch the editable fields. The protected fields are checked
      // separately so they can never change.
      allow update: if isOwner(uid)
        && request.resource.data.collegeId == resource.data.collegeId
        && request.resource.data.role == resource.data.role
        && request.resource.data.karma == resource.data.karma
        && request.resource.data.badges == resource.data.badges
        // Bio and photo are bounded here too, so a modified client cannot store
        // an oversized profile that other students' chat docs would copy.
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 500
        && (request.resource.data.avatarUrl == ''
          || request.resource.data.avatarUrl.matches('^https://.+$'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'username',
          'department',
          'year',
          'graduationYear',
          'bio',
          'avatarUrl',
          'skills',
          'interests'
        ]);

      // Profiles are removed by a future account-deletion flow, not by the client.
      allow delete: if false;

      // FCM registration tokens. Only the owner can see or change their devices.
      match /devices/{tokenId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.token == tokenId
          && request.resource.data.platform == 'android';
      }
    }

    match /usernames/{username} {
      // Signed-in students can check whether a username is already taken.
      allow read: if isSignedIn();

      // A username reservation can only be created when it is free, and it must
      // point at the signed-in user.
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.uid == request.auth.uid;

      // The owner can release their old reservation when changing username.
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // A reservation is never edited; it is deleted and re-created instead.
      allow update: if false;
    }

    // The follow graph. Chat requests use it to tell connected students from new
    // ones: a direct chat starts accepted when either side follows the other.
    match /follows/{followId} {
      // Only the two students on an edge can read it. Chat creation checks both
      // directions with `exists()`, which bypasses this rule, so the follow graph
      // is not exposed to other students.
      allow read: if isSignedIn()
        && (resource.data.followerId == myUid()
          || resource.data.followeeId == myUid());

      allow create: if isSignedIn()
        && request.resource.data.followerId == myUid()
        && request.resource.data.followeeId is string
        && request.resource.data.followeeId != myUid()
        && followId == myUid() + '_' + request.resource.data.followeeId
        && request.resource.data.createdAt == request.time;

      allow delete: if isSignedIn() && resource.data.followerId == myUid();

      allow update: if false;
    }

    // Message boards. The owner creates one document per board in the Firebase
    // console; students only read the boards for their own college.
    match /boards/{boardId} {
      allow read: if isSignedIn() && isSameCollege(resource.data.collegeId);
      allow write: if false;

      match /threads/{threadId} {
        allow read: if isSignedIn() && isSameCollege(resource.data.collegeId);

        allow create: if isSignedIn()
          && request.resource.data.boardId == boardId
          && request.resource.data.collegeId == myCollegeId()
          && get(/databases/$(database)/documents/boards/$(boardId)).data.collegeId == myCollegeId()
          && request.resource.data.createdAt == request.time
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && request.resource.data.score == 0
          && request.resource.data.upvotedBy == []
          && request.resource.data.downvotedBy == []
          && request.resource.data.commentCount == 0
          && request.resource.data.pinned == false
          && request.resource.data.isAnonymous is bool
          && request.resource.data.reportCount == 0
          // Normal threads keep the exact author identity. Anonymous threads
          // must not contain authorId or authorName at all; only the private
          // ghostIdentities document knows who wrote them.
          && (
            (request.resource.data.isAnonymous == false
              && request.resource.data.authorId == myUid()
              && request.resource.data.authorName == myProfile().name)
            || (request.resource.data.isAnonymous == true
              && !('authorId' in request.resource.data)
              && !('authorName' in request.resource.data)
              && request.resource.data.anonAlias is string
              && request.resource.data.anonAlias.size() >= 3
              && request.resource.data.anonAlias.size() <= 40)
          );

        // Only four kinds of edits exist: a student's own vote, the +1/-1
        // comment counter written with a comment, a moderator's pin toggle, and
        // the ghost report count (increment by a reporter, reset by a moderator).
        allow update: if isSignedIn() && isSameCollege(resource.data.collegeId) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'upvotedBy',
            'downvotedBy',
            'score'
          ]) && validVote(resource.data, request.resource.data))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && (
              request.resource.data.commentCount == resource.data.commentCount + 1
              || (resource.data.commentCount > 0
                && request.resource.data.commentCount == resource.data.commentCount - 1)
            ))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
            && request.resource.data.pinned is bool
            && isBoardModerator(boardId))
          ||
          // A ghost report increments the counter by exactly one. Rules cannot
          // see the matching ghostReports write in the same batch, so the client
          // pair (report + increment) is the enforcement boundary here.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
            && resource.data.get('isAnonymous', false) == true
            && request.resource.data.reportCount == resource.data.reportCount + 1)
          ||
          // Restore clears the counter so a moderator can bring the item back.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
            && resource.data.get('isAnonymous', false) == true
            && request.resource.data.reportCount == 0
            && isBoardModerator(boardId))
        );

        // Anonymous items have no authorId; ownership is proven by the private
        // identity document, which the author cannot read but rules can.
        allow delete: if isSignedIn() && (
          isBoardModerator(boardId)
          || (resource.data.get('isAnonymous', false) == false
            && isOwner(resource.data.authorId))
          || (resource.data.get('isAnonymous', false) == true
            && get(/databases/$(database)/documents/ghostIdentities/$(threadId)).data.uid == myUid())
        );

        match /comments/{commentId} {
          function parentThread() {
            return get(/databases/$(database)/documents/boards/$(boardId)/threads/$(threadId)).data;
          }

          function parentComment() {
            return get(/databases/$(database)/documents/boards/$(boardId)/threads/$(threadId)/comments/$(request.resource.data.parentId)).data;
          }

          allow read: if isSignedIn() && isSameCollege(parentThread().collegeId);

          allow create: if isSignedIn()
            && isSameCollege(parentThread().collegeId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 500
            && request.resource.data.depth is int
            && request.resource.data.depth >= 0
            && request.resource.data.depth <= 3
            && request.resource.data.score == 0
            && request.resource.data.upvotedBy == []
            && request.resource.data.downvotedBy == []
            && request.resource.data.isAnonymous is bool
            && request.resource.data.reportCount == 0
            // Same rule as threads: normal comments carry the author, anonymous
            // comments carry only the alias and a private identity document.
            && (
              (request.resource.data.isAnonymous == false
                && request.resource.data.authorId == myUid()
                && request.resource.data.authorName == myProfile().name)
              || (request.resource.data.isAnonymous == true
                && !('authorId' in request.resource.data)
                && !('authorName' in request.resource.data)
                && request.resource.data.anonAlias is string
                && request.resource.data.anonAlias.size() >= 3
                && request.resource.data.anonAlias.size() <= 40)
            )
            // A top-level comment has no parent; a reply must point at a comment
            // exactly one level shallower, so depth cannot be faked.
            && (
              (request.resource.data.parentId == null
                && request.resource.data.depth == 0)
              || (request.resource.data.parentId is string
                && exists(/databases/$(database)/documents/boards/$(boardId)/threads/$(threadId)/comments/$(request.resource.data.parentId))
                && parentComment().depth == request.resource.data.depth - 1)
            );

          allow update: if isSignedIn()
            && isSameCollege(parentThread().collegeId)
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'upvotedBy',
                'downvotedBy',
                'score'
              ]) && validVote(resource.data, request.resource.data))
              ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
                && resource.data.get('isAnonymous', false) == true
                && request.resource.data.reportCount == resource.data.reportCount + 1)
              ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
                && resource.data.get('isAnonymous', false) == true
                && request.resource.data.reportCount == 0
                && isBoardModerator(boardId))
            );

          allow delete: if isSignedIn() && (
            isBoardModerator(boardId)
            || (resource.data.get('isAnonymous', false) == false
              && isOwner(resource.data.authorId))
            || (resource.data.get('isAnonymous', false) == true
              && get(/databases/$(database)/documents/ghostIdentities/$(commentId)).data.uid == myUid())
          );
        }

        // One report document per reporter per thread item. Its ID is the
        // reporter's UID, so a second report by the same student cannot exist.
        match /ghostReports/{reporterUid} {
          function parentThread() {
            return get(/databases/$(database)/documents/boards/$(boardId)/threads/$(threadId)).data;
          }

          allow create: if isSignedIn()
            && isSameCollege(parentThread().collegeId)
            && reporterUid == myUid()
            && request.resource.data.reporterId == myUid()
            && request.resource.data.itemId is string
            && request.resource.data.itemType in ['thread', 'comment']
            && request.resource.data.reason in [
              'spam',
              'harassment',
              'hate_speech',
              'misinformation',
              'other'
            ]
            && request.resource.data.details is string
            && request.resource.data.details.size() <= 500
            && request.resource.data.createdAt == request.time
            && (
              (request.resource.data.itemType == 'thread'
                && request.resource.data.itemId == threadId
                && parentThread().get('isAnonymous', false) == true)
              || (request.resource.data.itemType == 'comment'
                && exists(/databases/$(database)/documents/boards/$(boardId)/threads/$(threadId)/comments/$(request.resource.data.itemId))
                && get(/databases/$(database)/documents/boards/$(boardId)/threads/$(threadId)/comments/$(request.resource.data.itemId)).data.get('isAnonymous', false) == true)
            );

          allow read, update, delete: if false;
        }
      }
    }

    // Private identity of an anonymous thread or comment. Only this document
    // links the public, authorless item to a real UID. Board moderators can read
    // it; the author cannot (they may only delete it with their own item).
    match /ghostIdentities/{itemId} {
      allow read: if isSignedIn() && isBoardModerator(resource.data.boardId);

      allow create: if isSignedIn()
        && request.resource.data.uid == myUid()
        && request.resource.data.collegeId == myCollegeId()
        && request.resource.data.boardId is string
        && get(/databases/$(database)/documents/boards/$(request.resource.data.boardId)).data.collegeId == myCollegeId()
        && request.resource.data.threadId is string
        && request.resource.data.type in ['thread', 'comment']
        && request.resource.data.createdAt == request.time
        // For a thread the identity names itself; for a comment it names the
        // parent thread. The public document is in the same batch, which rules
        // cannot see, so this is the strongest check available without a server.
        && (request.resource.data.type == 'comment'
          || request.resource.data.threadId == itemId);

      // A normal item's delete batch also removes this document. It does not
      // exist for normal items, so allow the no-op delete.
      allow delete: if isSignedIn()
        && (resource == null
          || resource.data.uid == myUid()
          || isBoardModerator(resource.data.boardId));

      allow update: if false;
    }

    // A student's alias inside one thread. The owner can read and create only
    // their own alias; it is never edited, so the alias stays consistent.
    match /ghostAliases/{aliasId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.uid == myUid());

      allow create: if isSignedIn()
        && request.resource.data.uid == myUid()
        && request.resource.data.threadId is string
        && aliasId == request.resource.data.threadId + '_' + myUid()
        && request.resource.data.alias is string
        && request.resource.data.alias.size() >= 3
        && request.resource.data.alias.size() <= 40
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Daily anonymous allowance. The document ID is {uid}_{yyyyMMdd}; a client
    // batch increments it with the anonymous write. Rules cap the counter at 5
    // and only allow +1, but rules cannot prove the public write happened.
    match /ghostLimits/{limitId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.uid == myUid());

      allow create: if isSignedIn()
        && request.resource.data.uid == myUid()
        && limitId == myUid() + '_' + request.resource.data.date
        && request.resource.data.date is string
        && request.resource.data.date.size() == 8
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
        && resource.data.uid == myUid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 5
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Moderation audit trail. A reveal must write one of these first; only
    // moderators of that board can create or read them, and they are immutable.
    match /revealLogs/{logId} {
      allow read: if isSignedIn() && isBoardModerator(resource.data.boardId);

      allow create: if isSignedIn()
        && request.resource.data.moderatorUid == myUid()
        && request.resource.data.boardId is string
        && isBoardModerator(request.resource.data.boardId)
        && request.resource.data.itemId is string
        && exists(/databases/$(database)/documents/ghostIdentities/$(request.resource.data.itemId))
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Feed posts. The college feed is a bounded query on collegeId + createdAt,
    // so the read rule only needs to prove the caller belongs to that college.
    match /posts/{postId} {
      allow read: if isSignedIn() && isSameCollege(resource.data.collegeId);

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.collegeId == myCollegeId()
        && request.resource.data.authorName == myProfile().name
        && request.resource.data.authorUsername == myProfile().username
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy == []
        && request.resource.data.commentCount == 0
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 4;

      allow update: if isSameCollege(resource.data.collegeId) && (
        // The author can edit the text and image links.
        (isOwner(resource.data.authorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text',
            'imageUrls'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.imageUrls is list
          && request.resource.data.imageUrls.size() <= 4)
        ||
        // Anyone in the college can add or remove only their own like. The like
        // list is the source of truth, so likedBy.size is the like count.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && (
            (request.resource.data.likedBy.hasAll(resource.data.likedBy)
              && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
              && request.auth.uid in request.resource.data.likedBy)
            ||
            (resource.data.likedBy.hasAll(request.resource.data.likedBy)
              && resource.data.likedBy.size() == request.resource.data.likedBy.size() + 1
              && !(request.auth.uid in request.resource.data.likedBy))
          ))
        ||
        // Comments bump the denormalized count by exactly one.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && request.resource.data.commentCount == resource.data.commentCount + 1)
      );

      // Deleting a post removes the document. Its comments and likes become
      // unreachable because those rules require this post to exist.
      allow delete: if isOwner(resource.data.authorId);

      // Comments live in a subcollection. Threading is one level deep.
      match /comments/{commentId} {
        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }

        function parentIsTopLevel() {
          return request.resource.data.parentId == ''
            || (exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId))
              && get(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId)).data.parentId == '');
        }

        allow read: if isSignedIn() && isSameCollege(parentPost().collegeId);

        allow create: if isSignedIn()
          && isSameCollege(parentPost().collegeId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == myProfile().name
          && request.resource.data.authorUsername == myProfile().username
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.parentId is string
          && parentIsTopLevel();

        allow update, delete: if false;
      }
    }

    // Stories expire after 24 hours. The client filters on expiresAt and a
    // Firestore TTL policy on that field deletes expired documents, so no Cloud
    // Function is needed. Read rules must stay query-safe: filtering list rules
    // on request.time would break the story query.
    match /stories/{storyId} {
      allow read: if isSignedIn() && isSameCollege(resource.data.collegeId);

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.collegeId == myCollegeId()
        && request.resource.data.authorName == myProfile().name
        && request.resource.data.authorUsername == myProfile().username
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && request.resource.data.seenBy == []
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 500
        // Text stories carry no link; image stories need a public https link.
        && (
          (request.resource.data.type == 'text'
            && request.resource.data.text.size() > 0
            && request.resource.data.imageUrl == '')
          || (request.resource.data.type == 'image'
            && request.resource.data.imageUrl.matches('^https://.+$'))
        );

      // Viewers can only add themselves to seenBy; the author and prior viewers
      // are preserved.
      allow update: if isSameCollege(resource.data.collegeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
        && request.resource.data.seenBy.hasAll(resource.data.seenBy)
        && request.resource.data.seenBy.size() == resource.data.seenBy.size() + 1
        && request.auth.uid in request.resource.data.seenBy;

      allow delete: if isOwner(resource.data.authorId);
    }

    // Blocks are private to the student who created them.
    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;

      allow update: if false;
    }

    // Reports are write-only from the app. Only the Firebase console (or a future
    // trusted moderator tool) can read them.
    match /reports/{reportId} {
      allow read: if false;

      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.targetType in [
          'post',
          'comment',
          'story',
          'user',
          'thread',
          'board_comment'
        ]
        && request.resource.data.targetId is string
        && request.resource.data.reason in [
          'spam',
          'harassment',
          'hate_speech',
          'misinformation',
          'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Direct chats and group chats. Membership is the whole access model: only the
    // UIDs in `members` can read or write the chat and its messages.
    //
    // A direct chat is created accepted when either student follows the other.
    // Otherwise it starts as a request, and only the recipient can accept it.
    match /chats/{chatId} {
      function isChatMember() {
        return isSignedIn() && myUid() in resource.data.members;
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isGroup() {
        return resource.data.type == 'group';
      }

      function isGroupAdmin() {
        return isChatMember() && isGroup() && myUid() in resource.data.admins;
      }

      function directOtherUid() {
        return request.resource.data.members[0] == myUid()
          ? request.resource.data.members[1]
          : request.resource.data.members[0];
      }

      function followsEitherWay(uid) {
        return exists(/databases/$(database)/documents/follows/$(myUid() + '_' + uid))
          || exists(/databases/$(database)/documents/follows/$(uid + '_' + myUid()));
      }

      allow read: if isChatMember();

      // One-to-one chats. The document ID is deterministic, so a pair cannot end
      // up with two conversations.
      allow create: if isSignedIn()
        && request.resource.data.type == 'direct'
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && myUid() in request.resource.data.members
        // One extra read is affordable here (unlike a 50-member group), so a
        // direct chat cannot cross colleges even from a modified client.
        && get(/databases/$(database)/documents/users/$(directOtherUid())).data.collegeId == myCollegeId()
        && request.resource.data.createdBy == myUid()
        && request.resource.data.admins == []
        && request.resource.data.mutedBy == []
        && request.resource.data.readAt is map
        && request.resource.data.memberNames.size() == 2
        && request.resource.data.title is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && (
          (request.resource.data.status == 'request'
            && request.resource.data.requestedBy == myUid()
            && !followsEitherWay(directOtherUid()))
          || (request.resource.data.status == 'accepted'
            && request.resource.data.requestedBy == ''
            && followsEitherWay(directOtherUid()))
        );

      // Group chats. The creator is the first admin.
      allow create: if isSignedIn()
        && request.resource.data.type == 'group'
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 50
        && myUid() in request.resource.data.members
        && request.resource.data.createdBy == myUid()
        && request.resource.data.admins == [myUid()]
        && request.resource.data.status == 'accepted'
        && request.resource.data.requestedBy == ''
        && request.resource.data.mutedBy == []
        && request.resource.data.readAt is map
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.memberNames.size() == request.resource.data.members.size()
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time;

      allow update: if isSignedIn() && isChatMember() && (
        // A member moves only their own read marker.
        (changedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt is map
          && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([myUid()]))

        // A member mutes or unmutes the chat for themselves.
        || (changedKeys().hasOnly(['mutedBy'])
          && (
            (request.resource.data.mutedBy.hasAll(resource.data.mutedBy)
              && request.resource.data.mutedBy.size() == resource.data.mutedBy.size() + 1
              && myUid() in request.resource.data.mutedBy)
            || (resource.data.mutedBy.hasAll(request.resource.data.mutedBy)
              && resource.data.mutedBy.size() == request.resource.data.mutedBy.size() + 1
              && !(myUid() in request.resource.data.mutedBy))
          ))

        // The sender writes the chat list preview in the same batch as the message.
        || (changedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
          && request.resource.data.lastMessage.senderId == myUid()
          && request.resource.data.lastMessage.senderName == myProfile().name
          && request.resource.data.lastMessage.type in ['text', 'image']
          && request.resource.data.lastMessage.text is string
          && request.resource.data.lastMessage.text.size() <= 140
          && request.resource.data.lastMessage.at == request.time
          && request.resource.data.lastMessageAt == request.time
          && (resource.data.status == 'accepted'
            || resource.data.requestedBy == myUid()))

        // A group admin renames the group.
        || (isGroupAdmin()
          && changedKeys().hasOnly(['title'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 60)

        // A group admin promotes or demotes another member. The group always keeps
        // at least one admin, and admins are always members.
        || (isGroupAdmin()
          && changedKeys().hasOnly(['admins'])
          && request.resource.data.admins.hasOnly(resource.data.members)
          && request.resource.data.admins.size() > 0)

        // A group admin adds or removes members. The admin stays in the group and
        // admins are always members.
        || (isGroupAdmin()
          && changedKeys().hasOnly(['members', 'memberNames', 'admins'])
          && myUid() in request.resource.data.members
          && request.resource.data.members.size() <= 50
          && request.resource.data.memberNames.size() == request.resource.data.members.size()
          && request.resource.data.admins.hasOnly(request.resource.data.members)
          && (request.resource.data.members.hasAll(resource.data.members)
            || resource.data.members.hasAll(request.resource.data.members)))

        // A member leaves a group: only their own membership and admin entry go.
        || (changedKeys().hasOnly(['members', 'memberNames', 'admins'])
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(myUid() in request.resource.data.members)
          && request.resource.data.admins.hasOnly(request.resource.data.members))

        // The recipient accepts a message request.
        || (resource.data.status == 'request'
          && changedKeys().hasOnly(['status'])
          && request.resource.data.status == 'accepted'
          && myUid() in resource.data.members
          && myUid() != resource.data.requestedBy)
      );

      // Declining or cancelling a message request removes the chat. Accepted chats
      // leave the inbox only by leaving a group.
      allow delete: if isSignedIn()
        && isChatMember()
        && resource.data.status == 'request';

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        function canAccess() {
          return isSignedIn() && myUid() in parentChat().members;
        }

        allow read: if canAccess();

        allow create: if canAccess()
          && request.resource.data.senderId == myUid()
          && request.resource.data.senderName == myProfile().name
          && request.resource.data.createdAt == request.time
          && request.resource.data.type in ['text', 'image']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 500
          // A message is exactly one kind: text without a link, or an image with
          // an https link and an optional caption. Cleartext image links are
          // rejected so they can never be loaded over http.
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text.size() > 0
              && request.resource.data.imageUrl == '')
            || (request.resource.data.type == 'image'
              && request.resource.data.imageUrl.matches('^https://.+$'))
          )
          // Only the student who sent a pending request can write to it.
          && (parentChat().status == 'accepted'
            || parentChat().requestedBy == myUid());

        // Messages are immutable; a chat is the only thing that can be removed.
        allow update, delete: if false;
      }

      // Typing is a short-lived marker per member. Only its owner writes it.
      match /typing/{memberUid} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        function canAccess() {
          return isSignedIn() && myUid() in parentChat().members;
        }

        allow read: if canAccess();

        allow create, update: if canAccess()
          && memberUid == myUid()
          && request.resource.data.updatedAt == request.time;

        allow delete: if canAccess() && memberUid == myUid();
      }
    }

    // Pending message pushes. The client only writes a job for a chat it belongs
    // to; the trusted relay reads and deletes jobs with the Admin SDK, which
    // bypasses rules. No client can read the queue, and a TTL policy on `expireAt`
    // removes jobs nothing drained. See docs/PUSH.md.
    match /pushQueue/{jobId} {
      function jobChat() {
        return get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data;
      }

      // The job ID must be the ID of a real message the caller sent, so a member
      // cannot push notifications without a matching message. The relay reads the
      // notification text from that message, never from this document, so the
      // queue cannot be used to send forged notification copy.
      function jobMessage() {
        return get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(jobId)).data;
      }

      allow read: if false;

      allow create: if isSignedIn()
        && request.resource.data.chatId is string
        && request.resource.data.senderId == myUid()
        && jobMessage().senderId == myUid()
        && myUid() in jobChat().members
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(25, 'h');

      allow update, delete: if false;
    }

    // Everything not listed above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
